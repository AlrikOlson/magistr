{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "mcp__mcp-image__generate_image",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-image-gen.sh",
						"timeout": 120,
						"statusMessage": "Extracting transparent PNG..."
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/magistr-guard.sh stop",
						"timeout": 15
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": []
			},
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/magistr-guard.sh write",
						"timeout": 15
					}
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Read",
			"Edit",
			"Write",
			"NotebookEdit",
			"WebFetch",
			"WebSearch",
			"AskUserQuestion",
			"Agent",
			"Task",
			"TaskCreate",
			"TaskUpdate",
			"TaskList",
			"TaskGet",
			"TaskOutput",
			"TaskStop",
			"mcp__brave-search",
			"mcp__magistr",
			"mcp__mcp-domain-availability",
			"mcp__mcp-image",
			"mcp__sequentialthinking",
			"mcp__think-and-ship",
			"mcp__serpapi"
		],
		"deny": ["Glob", "Grep", "mcp__magistr__roadmap_export"]
	}
}
