---
import { version } from "../../../../npm/magistr/package.json";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import captures from "../../public/screenshots/captures.json";

const screenshot = (name: string) => {
  const capture = captures.images.find(({ file }) => file === name);
  if (!capture) throw new Error(`Missing product image: ${name}`);
  return `/screenshots/${name}?v=${capture.sha256.slice(0, 12)}`;
};

const jsonLd = [
  {"@context":"https://schema.org","@type":"WebSite","name":"Magistr","url":"https://magistr.dev"},
  {"@context":"https://schema.org","@type":"SoftwareApplication","name":"Magistr","softwareVersion":version,"description":"Keep your coding project's plan, progress and test results together.","url":"https://magistr.dev","applicationCategory":"DeveloperApplication","operatingSystem":"macOS (Apple Silicon)","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"downloadUrl":"https://magistr.dev/docs/installation","softwareRequirements":"Rust 1.95 or later","license":"https://github.com/AlrikOlson/magistr/blob/main/LICENSE"}
];
const desktopAlt = "Magistr showing a conversation about a Python fix in the Contact list project, with the proposed code and a command to test it.";
const steps = [
  {title:"Make a plan.", text:"Break the project into manageable steps. Give each one a clear goal and the checks it needs to pass."},
  {title:"Work through it.", text:"Let your agent take one ready step, make the change and run its checks. You choose when to continue."},
  {title:"Come back to it.", text:"Start a fresh session with the saved plan, completed work and test results ready to read."},
];
const docs = [
  {title:"Set up Magistr",text:"Installation, agent connections and troubleshooting.",href:"/docs/installation"},
  {title:"Plan your work",text:"Plans, agent sessions and checking what changed.",href:"/docs/concepts"},
];
---
<Base title="Magistr — pick up where you left off" description="Keep your coding project's plan, progress and test results together. Continue the work with Codex or Claude Code." jsonLd={jsonLd}>
  <Nav />
  <main id="main-content">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero-heading">
        <p class="eyebrow">For Codex &amp; Claude Code</p>
        <h1 id="hero-title">Pick up where<br /><span>you left off.</span></h1>
      </div>
      <div class="hero-copy">
        <p class="hero-lede">Good work takes more than one session. Magistr keeps your plan, progress and test results with your project, so your agent can keep moving.</p>
        <div class="hero-actions">
          <a id="install-btn" class="button button-primary" href="#install">Get started <span aria-hidden="true">↗</span></a>
          <a class="button button-quiet" href="#agents">See it in action <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-note">Runs on your Mac <span aria-hidden="true">·</span> Preview v{version}</p>
      </div>
      <figure class="capture hero-capture">
        <div class="capture-heading">
          <span class="capture-title">A place for your project’s conversations</span>
          <span class="preview-label">Desktop preview</span>
        </div>
        <div class="desktop-stage">
          <a class="capture-light" href={screenshot("desktop-light.png")} aria-label="Open the full-size Magistr desktop screenshot">
            <img src={screenshot("desktop-light.png")} alt={desktopAlt} width="2560" height="1664" fetchpriority="high" />
          </a>
          <a class="capture-dark" href={screenshot("desktop-dark.png")} aria-label="Open the full-size Magistr desktop screenshot">
            <img src={screenshot("desktop-dark.png")} alt={desktopAlt} width="2560" height="1664" fetchpriority="high" />
          </a>
        </div>
        <figcaption><span>Review source, talk through a fix and return to the conversation.</span><span>The desktop preview is available from source.</span></figcaption>
      </figure>
    </section>

    <section id="roadmap" class="section-shell section-block workflow" aria-labelledby="roadmap-title" tabindex="-1">
      <div class="section-heading heading-split">
        <div><p class="eyebrow">How it works</p><h2 id="roadmap-title">A clear next step.<br />Every time you return.</h2></div>
        <p>A roadmap gives your agent direction. Magistr keeps the plan and the work together, from the first idea to the last passing check.</p>
      </div>
      <ol class="work-steps">
        {steps.map((step, index) => <li><span class="step-number" aria-hidden="true">0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}
      </ol>
      <div class="command-strip">
        <code>magistr next</code>
        <p>Continue unfinished work, or complete one ready step.</p>
        <a class="text-link" href="/docs/concepts">How the plan works <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section id="agents" class="agent-section" aria-labelledby="agents-title" tabindex="-1">
      <div class="section-shell section-block">
        <div class="section-heading heading-split">
          <div><p class="eyebrow">In your agent</p><h2 id="agents-title">New session.<br />Same project.</h2></div>
          <p>Work in Codex or Claude Code. When you return, your agent can read what changed, what passed and what comes next.</p>
        </div>
        <div class="agent-sessions">
          <figure class="capture agent-session">
            <div class="agent-heading"><h3>Codex</h3><span>01</span></div>
            <a href={screenshot("codex-session.png")} aria-label="Open the full-size Codex session screenshot">
              <img src={screenshot("codex-session.png")} alt="Codex reads a completed Magistr task and reports the whitespace fix and one passing test." width="2370" height="2120" loading="lazy" />
            </a>
            <figcaption><strong>The work is still there.</strong> A fresh Codex session finds the completed fix and its passing test.<a class="image-link" href={screenshot("codex-session.png")}>View full Codex session <span aria-hidden="true">↗</span></a></figcaption>
          </figure>
          <figure class="capture agent-session">
            <div class="agent-heading"><h3>Claude Code</h3><span>02</span></div>
            <a href={screenshot("claude-code-session.png")} aria-label="Open the full-size Claude Code session screenshot">
              <img src={screenshot("claude-code-session.png")} alt="Claude Code reads a completed Magistr task, describing the source change and the test that passed." width="2370" height="2120" loading="lazy" />
            </a>
            <figcaption><strong>The checks come with it.</strong> Claude Code reads the saved change and confirms which test passed.<a class="image-link" href={screenshot("claude-code-session.png")}>View full Claude Code session <span aria-hidden="true">↗</span></a></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="install" class="section-shell section-block install" aria-labelledby="install-title" tabindex="-1">
      <div class="install-grid">
        <div class="section-heading">
          <p class="eyebrow">Get started</p>
          <h2 id="install-title">Bring a project.<br />Make a plan.</h2>
          <p>Magistr is in preview for Apple Silicon Macs. Registry packages are not published yet; building from source requires repository access.</p>
          <p class="install-requirements">macOS 15 or later · Rust 1.95 or later</p>
          <a class="text-link" href="/docs/installation">Full installation guide <span aria-hidden="true">→</span></a>
        </div>
        <div class="code-panel">
          <p class="code-label">Install from source</p>
          <pre><code>git clone https://github.com/AlrikOlson/magistr.git
cd magistr
cargo install --locked --path crates/magistr-cli
magistr --version</code></pre>
        </div>
      </div>
      <ol class="setup-steps">
        <li><span class="step-number" aria-hidden="true">01</span><div><h3>Set up your project</h3><p><code>magistr init .</code> helps you choose your agents and review the setup.</p></div></li>
        <li><span class="step-number" aria-hidden="true">02</span><div><h3>Check the connection</h3><p><code>magistr doctor .</code> checks everything is ready and helps fix connection problems.</p></div></li>
        <li><span class="step-number" aria-hidden="true">03</span><div><h3>Plan your first step</h3><p>Launch your agent and use the starter prompt. Setup does not start implementation.</p></div></li>
      </ol>
    </section>

    <section class="section-shell docs-index" aria-labelledby="docs-title">
      <div><p class="eyebrow">A little more detail</p><h2 id="docs-title">Make yourself at home.</h2></div>
      <div class="doc-links">{docs.map((doc) =>
        <a href={doc.href}><strong>{doc.title}</strong><span>{doc.text}</span><span aria-hidden="true">↗</span></a>
      )}</div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="section-shell">
      <a class="footer-brand" href="/">Magistr<span>Plans, progress and a place to continue.</span></a>
      <div class="footer-links">
        <a href="/docs/installation">Documentation</a>
        <a href="https://github.com/AlrikOlson/magistr" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
      </div>
    </div>
  </footer>
</Base>
