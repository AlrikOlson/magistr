---
import { version } from "../../../../npm/magistr/package.json";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import captures from "../../public/screenshots/captures.json";

const screenshot = (name: string) => {
  const capture = captures.images.find(({ file }) => file === name);
  if (!capture) throw new Error(`Missing product image: ${name}`);
  return `/screenshots/${name}?v=${capture.sha256.slice(0, 12)}`;
};

const jsonLd = [
  {"@context":"https://schema.org","@type":"WebSite","name":"Magistr","url":"https://magistr.dev"},
  {"@context":"https://schema.org","@type":"SoftwareApplication","name":"Magistr","softwareVersion":version,"description":"Roadmap and workflow management for coding agents.","url":"https://magistr.dev","applicationCategory":"DeveloperApplication","operatingSystem":"macOS (Apple Silicon)","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"downloadUrl":"https://magistr.dev/docs/installation","softwareRequirements":"Rust 1.95 or later","license":"https://github.com/AlrikOlson/magistr/blob/main/LICENSE"}
];

/** The current desktop in both appearances. */
const alt = {overview: "Magistr showing a source review in the Contact list project, with project navigation, a Python fix and a verification command."};

const docs = [
  {title:"Installation",text:"Install, initialize a project and connect an agent.",href:"/docs/installation"},
  {title:"Concepts",text:"Roadmap, sessions, recorded work, verification and project state.",href:"/docs/concepts"},
  {title:"Architecture",text:"Crate ownership and boundaries, in the repository.",href:"https://github.com/AlrikOlson/magistr/blob/main/docs/architecture/overview.md",external:true},
  {title:"Development",text:"Contributor commands and checks, in the repository.",href:"https://github.com/AlrikOlson/magistr/blob/main/docs/development.md",external:true},
];
---
<Base title="Magistr — roadmap and workflow for coding agents" description="Keep a roadmap, run one focused work item at a time, and keep the reasoning, changes and checks that explain how a project moved." jsonLd={jsonLd}>
  <Nav />
  <main id="main-content">
    <section class="hero section-shell">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> Pre-release · v{version}</p>
        <h1>Roadmap and workflow management <span>for coding agents.</span></h1>
        <p class="hero-lede">Magistr keeps a project's roadmap, runs one focused work item at a time, and records the reasoning, the changes and the checks along the way — in the project, not in a chat transcript.</p>
        <div class="hero-actions">
          <a id="install-btn" class="button button-primary" href="#install">Install <span aria-hidden="true">→</span></a>
          <a class="button button-quiet" href="/docs/installation">Read the docs</a>
        </div>
        <p class="hero-note">Runs locally · Apple Silicon macOS</p>
      </div>
      <figure class="capture hero-capture">
        <a class="capture-light" href={screenshot("desktop-light.png")}><img src={screenshot("desktop-light.png")} alt={alt.overview} width="2560" height="1664" fetchpriority="high" /></a>
        <a class="capture-dark" href={screenshot("desktop-dark.png")}><img src={screenshot("desktop-dark.png")} alt={alt.overview} width="2560" height="1664" fetchpriority="high" /></a>
        <figcaption>Review source, discuss a fix and keep the conversation with your project.</figcaption>
      </figure>
    </section>

    <section id="roadmap" class="section-shell section-block story" aria-labelledby="roadmap-title">
      <div class="story-copy">
        <p class="eyebrow">The roadmap</p>
        <h2 id="roadmap-title">One focused work item at a time.</h2>
        <ul class="facts">
          <li><strong>Keep the plan with the project.</strong> Work items carry their dependencies and acceptance criteria into the agent session.</li>
          <li><strong>Continue unfinished work.</strong> The agent recovers the recorded plan before choosing another item.</li>
          <li><strong>Keep the evidence.</strong> Findings, actions and checks explain how the work progressed.</li>
        </ul>
      </div>
      <div class="code-panel"><pre><code>magistr next
magistr next-loop --max-iterations 5
magistr validate</code></pre></div>
    </section>

    <section class="section-shell section-block story story-flip" aria-labelledby="conversation-title">
      <div class="story-copy">
        <p class="eyebrow">The desktop</p>
        <h2 id="conversation-title">A conversation in each working copy.</h2>
        <ul class="facts">
          <li><strong>Open a project.</strong> Switch between its working copies and keep separate agent sessions.</li>
          <li><strong>Stay in control.</strong> Read the reply as it arrives, answer permission requests or stop the current turn.</li>
          <li><strong>Keep your draft.</strong> Move between sessions and return to your unsent message.</li>
          <li><strong>Choose your appearance.</strong> Use light, dark or the system setting, with native text editing and clipboard support.</li>
        </ul>
      </div>
      <p>The desktop is a separate development build. Roadmap planning, recorded work and project setup are available through the command line and the connected agent's tools.</p>
    </section>

    <section id="agents" class="section-shell section-block" aria-labelledby="agents-title">
      <div class="section-heading">
        <p class="eyebrow">In your agent</p>
        <h2 id="agents-title">Pick up the work in Codex or Claude Code.</h2>
        <p>Both agents use the same Magistr tools to inspect source, record a plan, make a change and run checks. A new session can read what was completed and verified.</p>
      </div>
      <div class="agent-sessions">
        <figure class="capture agent-session">
          <h3>Codex</h3>
          <a href={screenshot("codex-session.png")} aria-label="Open the full-size Codex session screenshot">
            <img src={screenshot("codex-session.png")} alt="Codex reads a completed Magistr task and reports the whitespace fix and one passing test." width="2370" height="2120" loading="lazy" />
          </a>
          <figcaption>A fresh session recovers the completed task and its recorded test result. <span>Open the image to read it at full size.</span></figcaption>
        </figure>
        <figure class="capture agent-session">
          <h3>Claude Code</h3>
          <a href={screenshot("claude-code-session.png")} aria-label="Open the full-size Claude Code session screenshot">
            <img src={screenshot("claude-code-session.png")} alt="Claude Code reads a completed Magistr task, describing the source change and verified test receipt." width="2370" height="2120" loading="lazy" />
          </a>
          <figcaption>The source change and verification stay available after the original conversation. <span>Open the image to read it at full size.</span></figcaption>
        </figure>
      </div>
    </section>

    <section id="install" class="section-shell section-block install" aria-labelledby="install-title">
      <div class="section-heading"><p class="eyebrow">Install</p><h2 id="install-title">Try the preview on macOS.</h2><p>The first release targets Apple Silicon Macs with macOS 15 or later. Registry packages are not published yet. With repository access and Rust 1.95 or later, build the preview:</p></div>
      <div class="install-grid">
        <div class="code-panel">
          <pre><code>git clone https://github.com/AlrikOlson/magistr.git
cd magistr
cargo install --locked --path crates/magistr-cli
magistr --version</code></pre>
        </div>
        <aside class="callout">
          <p class="card-eyebrow">Then, in your project</p>
          <ol>
            <li><code>magistr init .</code> reviews your stack, selected agents and proposed setup.</li>
            <li><code>magistr doctor .</code> checks setup and reports how to fix connection problems.</li>
            <li>Launch your agent and start with the planning prompt. Setup does not start implementation.</li>
          </ol>
          <a href="/docs/installation">Full installation guide →</a>
        </aside>
      </div>
    </section>

    <section class="section-shell docs-index" aria-labelledby="docs-title">
      <div><p class="eyebrow">Keep reading</p><h2 id="docs-title">Documentation</h2></div>
      <div class="doc-links">{docs.map((doc) => doc.external
        ? <a href={doc.href} target="_blank" rel="noopener noreferrer"><strong>{doc.title}</strong><span>{doc.text}</span><span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
        : <a href={doc.href}><strong>{doc.title}</strong><span>{doc.text}</span><span aria-hidden="true">→</span></a>)}</div>
    </section>
  </main>
  <footer class="site-footer"><div class="section-shell"><span>Magistr · roadmap and workflow management for coding agents</span><a href="/docs/installation">Documentation</a><a href="https://github.com/AlrikOlson/magistr" target="_blank" rel="noopener noreferrer">Repository <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a><a href="https://github.com/AlrikOlson/magistr/issues" target="_blank" rel="noopener noreferrer">Issues <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a></div></footer>
</Base>
