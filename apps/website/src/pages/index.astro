---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import captures from "../../public/screenshots/captures.json";

const screenshot = (name: string) => {
  const capture = captures.images.find(({ file }) => file === name);
  if (!capture) throw new Error(`Missing terminal capture: ${name}`);
  return `/screenshots/${name}?v=${capture.sha256.slice(0, 12)}`;
};

const jsonLd = [
  {"@context":"https://schema.org","@type":"WebSite","name":"Magistr","url":"https://magistr.dev"},
  {"@context":"https://schema.org","@type":"SoftwareApplication","name":"Magistr","softwareVersion":"0.1.0","description":"Roadmap and workflow management for coding agents.","url":"https://magistr.dev","applicationCategory":"DeveloperApplication","operatingSystem":"macOS, Linux, Windows","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"downloadUrl":"https://github.com/AlrikOlson/magistr/releases","softwareRequirements":"Rust 1.95 or later","license":"https://github.com/AlrikOlson/magistr/blob/main/LICENSE"}
];

/** The terminal interface in both themes. */
const alt = {
  overview: "The conversation above the recorded reasoning, with the roadmap and selected step beside it and the message area below.",
  roadmap: "The Roadmap screen shows the full plan, filters and dependencies, with the selected item’s progress and available actions.",
  turn: "The conversation, retry test output and selected file changes, with a message draft and Stop button below.",
  session: "The reasoning shows two explored questions, numbered steps and the selected step’s result, explanation and next action.",
};

const docs = [
  {title:"Installation",text:"Install, initialize a project and connect an agent.",href:"/docs/installation"},
  {title:"Concepts",text:"Roadmap, sessions, recorded work, verification and project state.",href:"/docs/concepts"},
  {title:"Architecture",text:"Crate ownership and boundaries, in the repository.",href:"https://github.com/AlrikOlson/magistr/blob/main/docs/architecture/overview.md",external:true},
  {title:"Development",text:"Contributor commands and checks, in the repository.",href:"https://github.com/AlrikOlson/magistr/blob/main/docs/development.md",external:true},
];
---
<Base title="Magistr — roadmap and workflow for coding agents" description="Keep a roadmap, run one focused work item at a time, and keep the reasoning, changes and checks that explain how a project moved." jsonLd={jsonLd}>
  <Nav />
  <main id="main-content">
    <section class="hero section-shell">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> Open source · v0.1.0 · early release</p>
        <h1>Roadmap and workflow management <span>for coding agents.</span></h1>
        <p class="hero-lede">Magistr keeps a project's roadmap, runs one focused work item at a time, and records the reasoning, the changes and the checks along the way — in the project, not in a chat transcript.</p>
        <div class="hero-actions">
          <a id="install-btn" class="button button-primary" href="#install">Install <span aria-hidden="true">→</span></a>
          <a class="button button-quiet" href="/docs/installation">Read the docs</a>
        </div>
        <p class="hero-note">Runs locally · open source · no account</p>
      </div>
      <figure class="capture hero-capture">
        <a class="capture-light" href={screenshot("terminal-overview-light.png")}><img src={screenshot("terminal-overview-light.png")} alt={alt.overview} width="1440" height="1000" fetchpriority="high" /></a>
        <a class="capture-dark" href={screenshot("terminal-overview-dark.png")}><img src={screenshot("terminal-overview-dark.png")} alt={alt.overview} width="1440" height="1000" fetchpriority="high" /></a>
        <figcaption>Keep the conversation, roadmap and reasoning together while work progresses.</figcaption>
      </figure>
    </section>

    <section id="roadmap" class="section-shell section-block story" aria-labelledby="roadmap-title">
      <div class="story-copy">
        <p class="eyebrow">The roadmap</p>
        <h2 id="roadmap-title">Work items, their dependencies, and what is ready next.</h2>
        <ul class="facts">
          <li><strong>See the full plan.</strong> Open the Roadmap screen to filter and sort work items, follow their dependencies and see what is ready next.</li>
          <li><strong>Select an item to see its context.</strong> Read its status, acceptance criteria and available actions alongside the plan.</li>
          <li><strong>Ask for changes.</strong> Choose “Request a change” to start a message about the selected item, then edit and send it. Your existing draft is kept.</li>
          <li><strong>Return to your conversation.</strong> Your message draft and place in the conversation stay as you left them.</li>
          <li><strong>One item at a time.</strong> The item in progress carries its acceptance criteria and its dependencies into the session that works on it.</li>
        </ul>
      </div>
      <figure class="capture">
        <a class="capture-light" href={screenshot("terminal-roadmap-light.png")}><img src={screenshot("terminal-roadmap-light.png")} alt={alt.roadmap} loading="lazy" width="1440" height="1000" /></a>
        <a class="capture-dark" href={screenshot("terminal-roadmap-dark.png")}><img src={screenshot("terminal-roadmap-dark.png")} alt={alt.roadmap} loading="lazy" width="1440" height="1000" /></a>
        <figcaption>Open Roadmap for the full plan, its dependencies and the details of each work item.</figcaption>
      </figure>
    </section>

    <section id="turn" class="section-shell section-block story story-flip" aria-labelledby="turn-title">
      <div class="story-copy">
        <p class="eyebrow">The conversation</p>
        <h2 id="turn-title">Follow the agent's work and inspect each tool call.</h2>
        <ul class="facts">
          <li><strong>The conversation in context.</strong> Read messages and tool calls while the roadmap and reasoning stay in view.</li>
          <li><strong>Command output where it happens.</strong> Expand a run to see its terminal output alongside the conversation.</li>
          <li><strong>Inspect a change.</strong> Select an edit to read the changes, open the file or undo that edit.</li>
          <li><strong>Give the next direction.</strong> Write a message, add files and send when ready. Stop the current work while keeping your draft.</li>
        </ul>
      </div>
      <figure class="capture">
        <a class="capture-light" href={screenshot("terminal-turn-light.png")}><img src={screenshot("terminal-turn-light.png")} alt={alt.turn} loading="lazy" width="1440" height="1000" /></a>
        <a class="capture-dark" href={screenshot("terminal-turn-dark.png")}><img src={screenshot("terminal-turn-dark.png")} alt={alt.turn} loading="lazy" width="1440" height="1000" /></a>
        <figcaption>Read command output and file changes alongside your conversation.</figcaption>
      </figure>
    </section>

    <section class="section-shell section-block story" aria-labelledby="trace-title">
      <div class="story-copy">
        <p class="eyebrow">Reasoning and recorded work</p>
        <h2 id="trace-title">The reasoning and checks stay with the project.</h2>
        <ul class="facts">
          <li><strong>Follow each question.</strong> See where an investigation began, the steps it contains and where its findings were used.</li>
          <li><strong>Understand the reasoning.</strong> Select a step to read what Magistr considered, its conclusion, what comes next and the work linked to it. Return to the latest step whenever you’re ready.</li>
          <li><strong>Actions and checks.</strong> Open Records to review reasoning, actions, checks and file changes in time order.</li>
        </ul>
      </div>
      <figure class="capture">
        <a class="capture-light" href={screenshot("terminal-session-light.png")}><img src={screenshot("terminal-session-light.png")} alt={alt.session} loading="lazy" width="1440" height="1000" /></a>
        <a class="capture-dark" href={screenshot("terminal-session-dark.png")}><img src={screenshot("terminal-session-dark.png")} alt={alt.session} loading="lazy" width="1440" height="1000" /></a>
        <figcaption>Select a step to follow its explanation and related work. Your conversation and draft stay in place.</figcaption>
      </figure>
    </section>

    <section id="install" class="section-shell section-block install" aria-labelledby="install-title">
      <div class="section-heading"><p class="eyebrow">Install</p><h2 id="install-title">Install from the repository.</h2><p>v0.1.0 is an early development release. It builds with Rust 1.95 or later; there is no registry package yet.</p></div>
      <div class="install-grid">
        <div class="code-panel">
          <pre><code>git clone https://github.com/AlrikOlson/magistr.git
cd magistr
cargo install --locked --path crates/magistr-cli
magistr --version</code></pre>
        </div>
        <aside class="callout">
          <p class="card-eyebrow">Then, in your project</p>
          <ol>
            <li><code>magistr init .</code> detects the stack and writes the project file and the agent setup.</li>
            <li><code>magistr</code> opens the terminal interface.</li>
            <li><code>magistr next</code> runs one ready work item; <code>magistr next-loop</code> continues through fresh sessions.</li>
          </ol>
          <a href="/docs/installation">Full installation guide →</a>
        </aside>
      </div>
    </section>

    <section class="section-shell docs-index" aria-labelledby="docs-title">
      <div><p class="eyebrow">Keep reading</p><h2 id="docs-title">Documentation</h2></div>
      <div class="doc-links">{docs.map((doc) => doc.external
        ? <a href={doc.href} target="_blank" rel="noopener noreferrer"><strong>{doc.title}</strong><span>{doc.text}</span><span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
        : <a href={doc.href}><strong>{doc.title}</strong><span>{doc.text}</span><span aria-hidden="true">→</span></a>)}</div>
    </section>
  </main>
  <footer class="site-footer"><div class="section-shell"><span>Magistr · roadmap and workflow management for coding agents</span><a href="/docs/installation">Documentation</a><a href="https://github.com/AlrikOlson/magistr" target="_blank" rel="noopener noreferrer">Repository <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a><a href="https://github.com/AlrikOlson/magistr/issues" target="_blank" rel="noopener noreferrer">Issues <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a></div></footer>
</Base>
