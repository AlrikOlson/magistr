---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---
<Base title="Page not found — Magistr" description="We couldn’t find that page. Go back to Magistr or open the docs." noindex={true}>
  <Nav />
  <main id="main-content" class="section-shell not-found">
    <p class="error-number" aria-hidden="true">404</p>
    <h1>Page not found.</h1>
    <p>This address doesn’t match a page on Magistr. Check the link, return home, or look in the installation guide.</p>
    <nav class="hero-actions" aria-label="Where to go instead">
      <a class="button button-primary" href="/">Back to Magistr</a>
      <a class="button button-quiet" href="/docs/installation">Open installation guide</a>
    </nav>
  </main>
  <Footer />
</Base>