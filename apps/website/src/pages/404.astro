---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
---

<Base title="Page not found — Magistr" noindex={true}>
  <Nav />
  <main id="main-content" class="section-shell not-found">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>There is nothing at this address.</p>
    <nav class="hero-actions" aria-label="Where to go instead">
      <a class="button button-primary" href="/">Home</a>
      <a class="button button-quiet" href="/docs/installation">Documentation</a>
    </nav>
  </main>
</Base>
