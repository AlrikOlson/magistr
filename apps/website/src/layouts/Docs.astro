---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import { getCollection } from "astro:content";

interface Props { title: string; description: string; currentSlug: string; }
const { title, description, currentSlug } = Astro.props;
const allDocs = await getCollection("docs");
const sorted = allDocs.sort((a,b)=>a.data.order-b.data.order);
// The docs are a short flat list; the order comes from each page.
const breadcrumbLd = {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Home","item":"https://magistr.dev"},
  {"@type":"ListItem","position":2,"name":"Docs","item":"https://magistr.dev/docs"},
  {"@type":"ListItem","position":3,"name":title,"item":`https://magistr.dev/docs/${currentSlug}`}
]};
---
<Base title={`${title} — Magistr docs`} description={description} jsonLd={breadcrumbLd}>
  <Nav />
  <div class="docs-layout section-shell">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <a class="docs-back" href="/">← Magistr home</a>
      <div id="docs-search"></div>
      <nav class="docs-nav-group" aria-label="Documentation pages"><ul>{sorted.map((doc)=>{
        const active=doc.id===currentSlug;
        return <li><a href={`/docs/${doc.id}`} aria-current={active?"page":undefined} class:list={{active}}>{doc.data.title}</a></li>;
      })}</ul></nav>
      <div class="docs-repo-links"><a href="https://github.com/AlrikOlson/magistr/blob/main/docs/architecture/overview.md" target="_blank" rel="noopener noreferrer">Architecture ↗</a><a href="https://github.com/AlrikOlson/magistr/blob/main/docs/development.md" target="_blank" rel="noopener noreferrer">Development ↗</a></div>
    </aside>
    <main id="main-content" class="docs-main" data-pagefind-body>
      <div class="docs-breadcrumb"><a href="/">Magistr</a><span aria-hidden="true">/</span><a href="/docs/installation">Docs</a><span aria-hidden="true">/</span><span>{title}</span></div>
      <article class="docs-content"><slot /></article>
    </main>
  </div>
</Base>
<script is:inline>
  async function initSearch(){
    const container=document.getElementById("docs-search"); if(!container) return;
    try{
      const pagefind=await import("/pagefind/pagefind.js"); await pagefind.init();
      const input=document.createElement("input"); input.type="search"; input.placeholder="Search docs"; input.className="docs-search-input"; input.setAttribute("aria-label","Search documentation"); container.appendChild(input);
      const results=document.createElement("div"); results.className="docs-search-results"; container.appendChild(results);
      let timer; input.addEventListener("input",()=>{clearTimeout(timer); timer=setTimeout(async()=>{results.innerHTML=""; const q=input.value.trim(); if(!q)return; const search=await pagefind.search(q); for(const result of search.results.slice(0,5)){const data=await result.data(); const link=document.createElement("a"); link.href=data.url; link.textContent=data.meta?.title||data.url; results.appendChild(link);}},180);});
    }catch{ /* Pagefind is generated for production builds. */ }
  }
  if(document.readyState==="loading") document.addEventListener("DOMContentLoaded",initSearch); else initSearch();
</script>
