---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import { getCollection } from "astro:content";

interface Props { title: string; description: string; currentSlug: string; }
const { title, description, currentSlug } = Astro.props;
const allDocs = await getCollection("docs");
const sorted = allDocs.sort((a,b)=>a.data.order-b.data.order);
// The docs are a short flat list; the order comes from each page.
const breadcrumbLd = {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Home","item":"https://magistr.dev"},
  {"@type":"ListItem","position":2,"name":"Docs","item":"https://magistr.dev/docs"},
  {"@type":"ListItem","position":3,"name":title,"item":`https://magistr.dev/docs/${currentSlug}`}
]};
---
<Base title={`${title} — Magistr docs`} description={description} jsonLd={breadcrumbLd}>
  <Nav />
  <div class="docs-layout section-shell">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <a class="docs-back" href="/">← Magistr home</a>
      <div id="docs-search">
        <input type="search" placeholder="Search docs" class="docs-search-input" aria-label="Search documentation" />
        <div class="docs-search-results" aria-live="polite"></div>
      </div>
      <nav class="docs-nav-group" aria-label="Documentation pages"><ul>{sorted.map((doc)=>{
        const active=doc.id===currentSlug;
        return <li><a href={`/docs/${doc.id}`} aria-current={active?"page":undefined} class:list={{active}}>{doc.data.title}</a></li>;
      })}</ul></nav>
      <div class="docs-repo-links"><a href="https://github.com/AlrikOlson/magistr/blob/main/docs/architecture/overview.md" target="_blank" rel="noopener noreferrer">Architecture ↗</a><a href="https://github.com/AlrikOlson/magistr/blob/main/docs/development.md" target="_blank" rel="noopener noreferrer">Development ↗</a></div>
    </aside>
    <main id="main-content" class="docs-main" data-pagefind-body>
      <div class="docs-breadcrumb"><a href="/">Magistr</a><span aria-hidden="true">/</span><a href="/docs/installation">Docs</a><span aria-hidden="true">/</span><span>{title}</span></div>
      <article class="docs-content"><slot /></article>
    </main>
  </div>
</Base>
<script is:inline>
  (() => {
    const input = document.querySelector(".docs-search-input");
    const results = document.querySelector(".docs-search-results");
    if (!input || !results) return;
    let timer, revision = 0, pagefindPromise;
    const search = async (query, request) => {
      results.textContent = "Searching…";
      try {
        pagefindPromise ??= import("/pagefind/pagefind.js");
        const pagefind = await pagefindPromise;
        if (request !== revision) return;
        const search = await pagefind.search(query);
        const matches = await Promise.all(search.results.slice(0, 5).map((result) => result.data()));
        if (request !== revision) return;
        results.replaceChildren();
        if (!matches.length) results.textContent = "Nothing found. Try another word.";
        for (const data of matches) {
          const link = document.createElement("a");
          link.href = data.url;
          link.textContent = data.meta?.title || data.url;
          results.appendChild(link);
        }
      } catch {
        if (request === revision) results.textContent = "Search is unavailable. Reload or use the links below.";
      }
    };
    input.addEventListener("input", () => {
      clearTimeout(timer);
      const request = ++revision;
      const query = input.value.trim();
      results.replaceChildren();
      if (query) timer = setTimeout(() => search(query, request), 180);
    });
    addEventListener("pagehide", () => {
      clearTimeout(timer);
      revision++;
      pagefindPromise?.then((pagefind) => pagefind.destroy()).catch(() => {});
    });
    addEventListener("pageshow", (event) => {
      if (event.persisted && input.value.trim()) input.dispatchEvent(new Event("input"));
    });
  })();
</script>
