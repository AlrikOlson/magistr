---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { docPath, groupDocs } from "../data/docs.mjs";
import "../styles/docs.css";

interface Props {
  doc: CollectionEntry<"docs">;
  headings: { depth: number; slug: string; text: string }[];
}
const { doc, headings } = Astro.props;
const allDocs = await getCollection("docs");
const sections = groupDocs(allDocs);
const section = sections.find(section => section.id === doc.data.section)!;
const related = doc.data.related.map(id => allDocs.find(page => page.id === id)!);
const home = doc.id === "index";
const crumbs = home
  ? [{ name: "Documentation", href: "/docs" }]
  : [
      { name: "Documentation", href: "/docs" },
      { name: section.title, href: `/docs#${section.id}` },
      { name: doc.data.title, href: docPath(doc.id) },
    ];
const breadcrumbLd = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: crumbs.map((crumb, index) => ({
    "@type": "ListItem", position: index + 1, name: crumb.name,
    item: new URL(crumb.href, Astro.site).href,
  })),
};
---
<Base title={home ? "Documentation — Magistr" : `${doc.data.title} — Magistr docs`} description={doc.data.description} jsonLd={breadcrumbLd}>
  <Nav />
  <div class="docs-layout section-shell">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <div id="docs-search">
        <label class="docs-search-label" for="search-docs">Search documentation</label>
        <input id="search-docs" type="search" placeholder="Search documentation" class="docs-search-input" autocomplete="off" />
        <div class="docs-search-results" aria-live="polite" aria-busy="false"></div>
      </div>
      <details class="docs-guide-list" open>
        <summary>Browse documentation <span aria-hidden="true">+</span></summary>
        <nav aria-label="Documentation pages">
          {sections.map(section => <div class="docs-nav-group">
            <p>{section.title}</p>
            <ul>{section.pages.map(page => <li><a href={docPath(page.id)} aria-current={page.id === doc.id ? "page" : undefined}>{page.data.title}</a></li>)}</ul>
          </div>)}
        </nav>
      </details>
    </aside>
    <main id="main-content" class="docs-main" tabindex="-1" data-doc-id={doc.id} data-pagefind-body data-pagefind-filter="collection:docs">
      <nav class="docs-breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
        <ol>{crumbs.map((crumb, index) => <li>{index === crumbs.length - 1 ? <span aria-current="page">{crumb.name}</span> : <a href={crumb.href}>{crumb.name}</a>}</li>)}</ol>
      </nav>
      <header class="docs-header"><h1 data-pagefind-meta="title">{doc.data.title}</h1><p>{doc.data.description}</p></header>
      {headings.some(heading => heading.depth === 2) && <details class="docs-contents" data-pagefind-ignore>
        <summary>On this page</summary>
        <nav aria-label="On this page">{headings.filter(heading => heading.depth === 2).map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
      </details>}
      <article class="docs-content"><slot /></article>
      <nav class="docs-related" aria-label="Related pages" data-pagefind-ignore>
        <h2>Related pages</h2>
        <ul>{related.map(page => <li><a href={docPath(page.id)}>{page.data.title}</a><p>{page.data.description}</p></li>)}</ul>
      </nav>
    </main>
  </div>
  <Footer />
</Base>
<script>
  import "../scripts/docs";
</script>
