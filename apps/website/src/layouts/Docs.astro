---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

interface Props { title: string; description: string; currentSlug: string; headings: {depth:number; slug:string; text:string}[]; }
const { title, description, currentSlug, headings } = Astro.props;
const allDocs = await getCollection("docs");
const sorted = allDocs.sort((a,b)=>a.data.order-b.data.order);
const currentIndex = sorted.findIndex((doc) => doc.id === currentSlug);
const nextDoc = sorted[currentIndex + 1];
const previousDoc = sorted[currentIndex - 1];
// Guides own their place in the reading order.
const breadcrumbLd = {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Home","item":"https://magistr.dev"},
  {"@type":"ListItem","position":2,"name":"Docs","item":"https://magistr.dev/docs"},
  {"@type":"ListItem","position":3,"name":title,"item":`https://magistr.dev/docs/${currentSlug}`}
]};
---
<Base title={`${title} — Magistr docs`} description={description} jsonLd={breadcrumbLd}>
  <Nav />
  <div class="docs-layout section-shell">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <p class="docs-label">Build with Magistr</p>
      <div id="docs-search">
        <label class="docs-search-label" for="search-docs">Documentation</label>
        <input id="search-docs" type="search" placeholder="Search docs" class="docs-search-input" aria-label="Search documentation" />
        <div class="docs-search-results" aria-live="polite"></div>
      </div>
      <details class="docs-guide-list" open><summary>Browse guides <span>{title}</span></summary><nav class="docs-nav-group" aria-label="Documentation pages"><ul>{sorted.map((doc)=>{
        const active=doc.id===currentSlug;
        return <li><a href={`/docs/${doc.id}`} aria-current={active?"page":undefined} class:list={{active}}>{doc.data.title}</a></li>;
      })}</ul></nav></details>
      <div class="docs-repo-links"><span class="supporting-label">Repository access required</span><a href="https://github.com/AlrikOlson/magistr/blob/main/docs/architecture/overview.md" target="_blank" rel="noopener noreferrer">Architecture</a><a href="https://github.com/AlrikOlson/magistr/blob/main/docs/development.md" target="_blank" rel="noopener noreferrer">Development</a></div>
    </aside>
    <main id="main-content" class="docs-main" data-pagefind-body>
      <header class="docs-header"><h1>{title}</h1><p>{description}</p></header>
      <details class="docs-contents">
        <summary>On this page</summary>
        <nav aria-label="On this page">{headings.filter(({depth}) => depth === 2).map(({slug,text}) => <a href={`#${slug}`}>{text}</a>)}</nav>
      </details>
      <article class="docs-content"><slot /></article>
      <nav class="docs-next" aria-label="More guides">{previousDoc && <a href={`/docs/${previousDoc.id}`}><small>Previous guide</small><span>← {previousDoc.data.title}</span></a>}{nextDoc && <a href={`/docs/${nextDoc.id}`}><small>Keep going</small><span>{nextDoc.data.title} →</span></a>}</nav>
    </main>
  </div>
  <Footer />
</Base>
<script is:inline>
  (() => {
    const guideList = document.querySelector(".docs-guide-list");
    const compact = matchMedia("(max-width: 800px)");
    const updateGuides = () => {
      const focused = guideList?.contains(document.activeElement);
      if (guideList) guideList.open = !compact.matches;
      if (focused && compact.matches) guideList.querySelector("summary")?.focus();
    };
    updateGuides();
    compact.addEventListener("change", updateGuides);
    const input = document.querySelector(".docs-search-input");
    const results = document.querySelector(".docs-search-results");
    if (!input || !results) return;
    let timer, revision = 0, pagefindPromise;
    const search = async (query, request) => {
      results.textContent = "Searching…";
      try {
        pagefindPromise ??= import("/pagefind/pagefind.js");
        const pagefind = await pagefindPromise;
        if (request !== revision) return;
        const search = await pagefind.search(query);
        const matches = await Promise.all(search.results.slice(0, 5).map((result) => result.data()));
        if (request !== revision) return;
        results.replaceChildren();
        if (!matches.length) results.textContent = "No results. Try a different word.";
        for (const data of matches) {
          const link = document.createElement("a");
          link.href = data.url;
          link.textContent = data.meta?.title || data.url;
          results.appendChild(link);
        }
      } catch {
        if (request === revision) results.textContent = "Search couldn’t load. Try reloading, or use the guide links below.";
      }
    };
    input.addEventListener("input", () => {
      clearTimeout(timer);
      const request = ++revision;
      const query = input.value.trim();
      results.replaceChildren();
      if (query) timer = setTimeout(() => search(query, request), 180);
    });
    addEventListener("pagehide", () => {
      clearTimeout(timer);
      revision++;
      pagefindPromise?.then((pagefind) => pagefind.destroy()).catch(() => {});
    });
    addEventListener("pageshow", (event) => {
      if (event.persisted && input.value.trim()) input.dispatchEvent(new Event("input"));
    });
  })();
</script>
