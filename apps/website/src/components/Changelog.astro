---
interface Release {
  tag: string;
  name: string;
  date: string;
  body: string;
  url: string;
}

let releases: Release[] = [];

try {
  const res = await fetch(
    "https://api.github.com/repos/AlrikOlson/magistr/releases?per_page=5",
    { headers: { Accept: "application/vnd.github.v3+json" } },
  );

  if (res.ok) {
    const data = await res.json();
    releases = (data as any[]).map((r) => ({
      tag: r.tag_name,
      name: r.name || r.tag_name,
      date: new Date(r.published_at).toLocaleDateString("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
      }),
      body: (r.body || "").split("\n").slice(0, 3).join(" ").slice(0, 200),
      url: r.html_url,
    }));
  }
} catch {
  // Graceful fallback — show empty state
}

const hasReleases = releases.length > 0;
---

<section id="changelog" class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="mb-12 text-center sm:mb-16">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        What&rsquo;s <span class="text-accent">new</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-text-muted">
        Latest releases and updates.
      </p>
    </div>

    {hasReleases ? (
      <div class="changelog-timeline space-y-6">
        {releases.map((release) => (
          <a
            href={release.url}
            target="_blank"
            rel="noopener noreferrer"
            class="changelog-entry group block rounded-xl border border-border p-6 transition-all hover:border-border-hover hover:shadow-lg"
            style="background-color: var(--color-bg-card);"
          >
            <div class="mb-2 flex items-center gap-3">
              <span class="rounded-md bg-accent/10 px-2.5 py-1 font-mono text-sm font-semibold text-accent">
                {release.tag}
              </span>
              <span class="text-sm text-text-muted">{release.date}</span>
            </div>
            <h3 class="mb-1 text-base font-semibold text-text group-hover:text-accent transition-colors">
              {release.name}
            </h3>
            {release.body && (
              <p class="text-sm leading-relaxed text-text-muted line-clamp-2">
                {release.body}
              </p>
            )}
          </a>
        ))}
      </div>
    ) : (
      <div class="changelog-empty rounded-xl border border-dashed border-border p-12 text-center">
        <p class="text-text-muted">
          No releases yet. Check back soon or
          <a
            href="https://github.com/AlrikOlson/magistr"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent hover:underline"
          >
            star the repo
          </a>
          to get notified.
        </p>
      </div>
    )}
  </div>
</section>
