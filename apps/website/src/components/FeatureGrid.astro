---
import FeatureCard from "./FeatureCard.astro";

const features = [
  {
    icon: "/icons/feature-scaffolding.png",
    title: "Scaffolding",
    description:
      "Auto-detects your stack and generates hooks, rules, and skills tailored to your project. One command to go from zero to a fully configured AI dev environment.",
    accent: "green",
  },
  {
    icon: "/icons/feature-iteration.png",
    title: "Recorded iteration",
    description:
      "Each selected chunk follows a recorded research-plan-execute-verify cycle. Magistr runs the configured gates and creates one atomic commit before you choose the next iteration.",
    accent: "accent",
  },
  {
    icon: "/icons/feature-tui.png",
    title: "Terminal cockpit",
    description:
      "The supported interactive terminal surface shows workflow phases, task progress, live output, and session controls while a run is active.",
    accent: "purple",
  },
  {
    icon: "/icons/feature-roadmap.png",
    title: "Roadmap Tracking",
    description:
      "Native roadmap state records dependencies, acceptance, progress, and discovered follow-up work. It stays in Magistr's store; roadmap exports are disabled.",
    accent: "orange",
  },
  {
    icon: "/icons/feature-tools.png",
    title: "Source tools & MCP",
    description:
      "Workbench provides verified search, reads, edits, undo, scripts, and declared commands; Magistr MCP exposes the workflow services that record plans and gates.",
    accent: "pink",
  },
  {
    icon: "/icons/feature-roadmap.png",
    title: "Desktop & peer protocol",
    description:
      "Experimental surfaces: the desktop viewer lives on the gui2 branch, and the peer protocol is a compatibility API without production runtime wiring.",
    accent: "orange",
  },
];
---

<section id="features" class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mb-12 text-center sm:mb-16">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Everything you need to
        <span class="text-accent">ship faster</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-text-muted">
        Magistr handles the orchestration so you can focus on what matters.
        From scaffolding to recorded iteration, every shipped feature is designed to keep you in flow.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <FeatureCard
          icon={f.icon}
          title={f.title}
          description={f.description}
          accent={f.accent}
        />
      ))}
    </div>
  </div>
</section>
