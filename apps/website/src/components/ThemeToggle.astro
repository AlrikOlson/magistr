---
/**
 * Sun/moon toggle for light/dark mode.
 * Reads system preference, persists to localStorage, applies .dark class to <html>.
 */
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="Toggle dark mode"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg class="theme-icon-sun hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>
  <!-- Moon icon (shown in light mode) -->
  <svg class="theme-icon-moon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script>
  function initThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;

    function updateIcons(isDark: boolean) {
      const sun = btn!.querySelector(".theme-icon-sun");
      const moon = btn!.querySelector(".theme-icon-moon");
      // In dark mode, show sun (to switch to light); in light mode, show moon
      sun?.classList.toggle("hidden", !isDark);
      moon?.classList.toggle("hidden", isDark);
    }

    function isDark() {
      return document.documentElement.classList.contains("dark");
    }

    // Sync icons with current state (set by head script)
    updateIcons(isDark());

    btn.addEventListener("click", () => {
      const nowDark = !isDark();
      document.documentElement.classList.toggle("dark", nowDark);
      localStorage.setItem("theme", nowDark ? "dark" : "light");
      updateIcons(nowDark);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initThemeToggle);
  } else {
    initThemeToggle();
  }
</script>
