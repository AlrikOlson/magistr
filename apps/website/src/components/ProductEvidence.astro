---
import captures from "../../public/screenshots/captures.json";
const screenshot = (name: string) => {
  const capture = captures.images.find(({ file }) => file === name);
  if (!capture) throw new Error(`Missing product image: ${name}`);
  return `/screenshots/${name}?v=${capture.sha256.slice(0, 12)}`;
};
const agents = [
  { id:"codex", title:"Codex", excerpt:["Change: Strip each input once, discard empty results, then lowercase the remaining names.", "Verified result: Magistr recorded python3 -m unittest -q passing the unchanged test: 1 test, exit 0."], file:"codex-session.png", text:"Codex reads the saved task and explains what was wrong, what changed, and which test passed.", detail:"The test ran in the earlier session. This chat reads that saved result.", alt:"Actual Codex terminal session calling Magistr context and reporting the whitespace fix, one unchanged passing test and exit code zero." },
  { id:"claude", title:"Claude Code", excerpt:["Change: The function body was rewritten via a verified Magistr edit to strip each name, drop names that are empty after stripping, then lowercase. Only names.py was touched. The test file was left unchanged.", "Verified result: The required test check ran python3 -m unittest -q through Magistr with exit code 0."], file:"claude-code-session.png", text:"Claude Code reads its saved task, finds the change to the function, and reports the passing test.", detail:"This is a separate run of the same example, not a transfer of the Codex session.", alt:"Actual Claude Code terminal session retrieving a completed Magistr task, describing the source change and one passing test with its saved check reference." },
];
---
<div class="product-evidence" data-tabset>
  <div class="evidence-tabs tab-controls" data-tablist aria-label="Product captures" hidden>
    <button id="evidence-tab-codex" type="button" data-tab aria-controls="evidence-panel-codex">Codex</button>
    <button id="evidence-tab-claude" type="button" data-tab aria-controls="evidence-panel-claude">Claude Code</button>
    <button id="evidence-tab-desktop" type="button" data-tab aria-controls="evidence-panel-desktop">Magistr desktop</button>
  </div>
  {agents.map((agent) => <div id={`evidence-panel-${agent.id}`} class="evidence-panel" data-panel>
    <div class="evidence-copy"><p class="capture-note">Recorded October 19, 2026</p><p>{agent.text}</p><p class="evidence-detail">{agent.detail}</p><a class="text-link image-link" href={screenshot(agent.file)}>Open full screenshot</a></div>
    <div class="capture-excerpt"><p class="capture-note">From the {agent.title} session</p><blockquote>{agent.excerpt.map((paragraph) => <p>{paragraph}</p>)}</blockquote></div>
    <figure class="capture agent-capture">
      <a class="capture-image" href={screenshot(agent.file)} aria-label={`Open the full-size ${agent.title} session screenshot`}><img src={screenshot(agent.file)} alt={agent.alt} width="2370" height="2120" loading="lazy" /></a>
      <figcaption>The recorded {agent.title} session. <a href={screenshot(agent.file)}>Open full size</a></figcaption>
    </figure>
  </div>)}
  <div id="evidence-panel-desktop" class="evidence-panel" data-panel>
    <div class="evidence-copy"><p class="capture-note">Desktop preview, October 19, 2026</p><p>The desktop shows a saved conversation about the same bug. You can read the proposed fix and the test the agent suggested.</p><p class="evidence-detail">This conversation proposed the change; it did not execute the fix or run the test. The desktop is available separately from source.</p><a class="text-link" href="/docs/installation#try-the-desktop-preview">Try the desktop preview</a></div>
    <div class="capture-excerpt"><p class="capture-note">From the desktop conversation</p><blockquote><p>Strip once, then filter on the stripped value:</p><pre><code>def normalize_names(names):
    stripped = (name.strip() for name in names)
    return [name.lower() for name in stripped if name]</code></pre><p>The existing test already covers this case. Run:</p><pre><code>python3 -m unittest -q</code></pre></blockquote></div>
    <figure class="capture desktop-capture">
      <a class="capture-image capture-light" href={screenshot("desktop-light.png")} aria-label="Open the full-size Magistr desktop light screenshot"><img src={screenshot("desktop-light.png")} alt="Magistr desktop in light appearance with a saved conversation showing the proposed Python fix and a suggested verification command." width="2560" height="1664" loading="lazy" /></a>
      <a class="capture-image capture-dark" href={screenshot("desktop-dark.png")} aria-label="Open the full-size Magistr desktop dark screenshot"><img src={screenshot("desktop-dark.png")} alt="Magistr desktop in dark appearance with the same saved conversation, proposed Python fix and suggested verification command." width="2560" height="1664" loading="lazy" /></a>
      <figcaption>Native macOS app. <a class="capture-light" href={screenshot("desktop-light.png")}>Open full size</a><a class="capture-dark" href={screenshot("desktop-dark.png")}>Open full size</a></figcaption>
    </figure>
  </div>
  <p class="evidence-provenance"><a href="/screenshots/captures.json">Screenshot dates and sources</a></p>
</div>
<script>
  import "../scripts/tabs";
</script>