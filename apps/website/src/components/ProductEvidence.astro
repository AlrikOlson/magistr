---
import captures from "../../public/screenshots/captures.json";
const screenshot = (name: string) => {
  const capture = captures.images.find(({ file }) => file === name);
  if (!capture) throw new Error(`Missing product image: ${name}`);
  return `/screenshots/${name}?v=${capture.sha256.slice(0, 12)}`;
};
const agents = [
  { id:"codex", title:"Codex", excerpt:["Change: Strip each input once, discard empty results, then lowercase the remaining names.", "Verified result: Magistr recorded python3 -m unittest -q passing the unchanged test: 1 test, exit 0."], file:"codex-session.png", heading:"A fresh session finds the finished task.", text:"Codex reads the saved work and reports the defect, the fix and the unchanged test that passed.", detail:"The test ran earlier. This session retrieves its recorded result.", alt:"Actual Codex terminal session calling Magistr context and reporting the whitespace fix, one unchanged passing test and exit code zero." },
  { id:"claude", title:"Claude Code", excerpt:["Change: The function body was rewritten via a verified Magistr edit to strip each name, drop names that are empty after stripping, then lowercase. Only names.py was touched. The test file was left unchanged.", "Verified result: The required test check ran python3 -m unittest -q through Magistr with exit code 0."], file:"claude-code-session.png", heading:"The change and its check stay together.", text:"Claude Code retrieves its completed normalization task, including the source edit and verified test result.", detail:"This is a separate run of the same example, not a transfer of the Codex session.", alt:"Actual Claude Code terminal session retrieving a completed Magistr task, describing the source change and one passing test with its saved check reference." },
];
---
<div class="product-evidence" data-tabset>
  <div class="evidence-tabs tab-controls" data-tablist aria-label="Product captures" hidden>
    <button id="evidence-tab-codex" type="button" data-tab aria-controls="evidence-panel-codex">Codex</button>
    <button id="evidence-tab-claude" type="button" data-tab aria-controls="evidence-panel-claude">Claude Code</button>
    <button id="evidence-tab-desktop" type="button" data-tab aria-controls="evidence-panel-desktop">Magistr desktop</button>
  </div>
  {agents.map((agent) => <div id={`evidence-panel-${agent.id}`} class="evidence-panel" data-panel>
    <div class="evidence-copy"><p class="mono-label">Actual terminal session / Oct 19, 2026</p><h3>{agent.heading}</h3><p>{agent.text}</p><p class="evidence-detail">{agent.detail}</p><a class="text-link image-link" href={screenshot(agent.file)}>Open original image <span aria-hidden="true">↗</span></a></div>
    <div class="capture-excerpt"><p class="mono-label">Transcript excerpt / {agent.title}</p><blockquote>{agent.excerpt.map((paragraph) => <p>{paragraph}</p>)}</blockquote></div>
    <figure class="capture agent-capture">
      <a class="capture-image" href={screenshot(agent.file)} aria-label={`Open the full-size ${agent.title} session screenshot`}><img src={screenshot(agent.file)} alt={agent.alt} width="2370" height="2120" loading="lazy" /></a>
      <figcaption>Real {agent.title} output, rendered from its terminal session. <a href={screenshot(agent.file)}>Inspect full size ↗</a></figcaption>
    </figure>
  </div>)}
  <div id="evidence-panel-desktop" class="evidence-panel" data-panel>
    <div class="evidence-copy"><p class="mono-label">Actual app / Oct 19, 2026</p><h3>A place to talk through the change.</h3><p>The desktop preview reopens a saved conversation about the same Contact list defect, with the proposed fix and test command.</p><p class="evidence-detail">This conversation proposed the change; it did not execute the fix or run the test. The desktop is available separately from source.</p><a class="text-link" href="/docs/installation#try-the-desktop-preview">Try the desktop preview <span aria-hidden="true">↗</span></a></div>
    <div class="capture-excerpt"><p class="mono-label">Transcript excerpt / Desktop conversation</p><blockquote><p>Strip once, then filter on the stripped value:</p><pre><code>def normalize_names(names):
    stripped = (name.strip() for name in names)
    return [name.lower() for name in stripped if name]</code></pre><p>The existing test already covers this case. Run:</p><pre><code>python3 -m unittest -q</code></pre></blockquote></div>
    <figure class="capture desktop-capture">
      <a class="capture-image capture-light" href={screenshot("desktop-light.png")} aria-label="Open the full-size Magistr desktop light screenshot"><img src={screenshot("desktop-light.png")} alt="Magistr desktop in light appearance with a saved conversation showing the proposed Python fix and a suggested verification command." width="2560" height="1664" loading="lazy" /></a>
      <a class="capture-image capture-dark" href={screenshot("desktop-dark.png")} aria-label="Open the full-size Magistr desktop dark screenshot"><img src={screenshot("desktop-dark.png")} alt="Magistr desktop in dark appearance with the same saved conversation, proposed Python fix and suggested verification command." width="2560" height="1664" loading="lazy" /></a>
      <figcaption>Native macOS app. <a class="capture-light" href={screenshot("desktop-light.png")}>Inspect full size ↗</a><a class="capture-dark" href={screenshot("desktop-dark.png")}>Inspect full size ↗</a></figcaption>
    </figure>
  </div>
  <p class="evidence-provenance">Original images are unmodified. <a href="/screenshots/captures.json">View capture dates and sources ↗</a></p>
</div>
<script>
  import "../scripts/tabs";
</script>
