---
import recording from "../../public/demo/inbox/recording.json";
import {checkOf,eventStatus} from "../data/project-recording.mjs";
import {sessionEntries,moments,momentIndex,timeLabel,entryTitle,entryBody,entryPreview} from "../data/session-replay.mjs";
import {publicAssetUrl} from "../../scripts/asset-url.mjs";
const asset=(name)=>publicAssetUrl("demo/inbox/"+name);
const entries=sessionEntries(recording);
const initial=momentIndex(entries,moments[0]);
---
<div class="build-recording" data-recording data-recording-url={asset("recording.json")} data-ready="false" data-index={initial}>
  <div class="session-terminal">
    <div class="terminal-heading"><strong><span aria-hidden="true">›_</span> Codex</strong><span>support-inbox</span><small data-session-status>Paused</small></div>
    <div class="session-scroll" tabindex="0" aria-label="Codex session transcript">
      {entries.map((entry,index)=>{
        const preview=entryPreview(entry);
        const selected=index===initial;
        return <article class="session-entry" data-entry={index} data-kind={entry.kind} data-selected={String(selected)} hidden={index>initial}>
          <button type="button" data-seek={index} disabled aria-label={"Go to "+timeLabel(entries,index)+": "+(entry.kind==="message"?entryTitle(entry)+" message":entry.event.title)}>
            <span class="entry-bullet" aria-hidden="true">{entry.kind==="message"&&entry.role==="user"?"›":"•"}</span>
            <span class="entry-label">{entryTitle(entry)}</span>
            <time>{timeLabel(entries,index)}</time>
            {entry.kind==="action"&&<span class="entry-status" data-status={eventStatus(entry.event)}>{eventStatus(entry.event)}</span>}
          </button>
          <p class="entry-summary" hidden={selected}>{entry.kind==="message"?entry.text:entry.event.title}</p>
          <div class="entry-detail" hidden={!selected}>
            {entry.kind==="action"&&<p class="entry-purpose">{entry.event.title}</p>}
            {entry.kind==="action"&&checkOf(entry.event)?.command&&<pre class="entry-command"><code>$ {checkOf(entry.event).command}</code></pre>}
            {entry.kind==="message"?<p class="entry-message">{preview.text}</p>:<pre class="entry-output"><code>{preview.text}</code></pre>}
            <button type="button" class="entry-expand" data-open-action hidden>{entry.kind==="message"?"Full message":preview.omitted>0?"Full "+(entry.event.kind==="write"?"file":"output")+" · "+preview.total+" lines":"Details"} <span aria-hidden="true">↗</span></button>
          </div>
        </article>;
      })}
    </div>
  </div>
  <div class="replay-controls" hidden>
    <div class="replay-scrubber"><label for="session-position" class="sr-only">Build timeline</label><input id="session-position" type="range" min="0" max={entries.length-1} step="1" value={initial} aria-label="Build timeline" /><output for="session-position" data-time>{timeLabel(entries,initial)} / {timeLabel(entries,entries.length-1)}</output></div>
    <div class="replay-transport">
      <button type="button" data-play aria-pressed="false">Play</button>
      <button type="button" data-previous aria-label="Previous message or action">←</button>
      <button type="button" data-next aria-label="Next message or action">→</button>
      <label class="replay-jump"><span class="sr-only">Jump to part of the build</span><select data-moment-select aria-label="Jump to part of the build">{moments.map((moment,index)=><option value={index}>{timeLabel(entries,momentIndex(entries,moment))} · {moment.label}</option>)}</select></label>
      <label class="replay-speed"><span class="sr-only">Playback speed</span><select data-speed aria-label="Playback speed"><option value="1">1×</option><option value="4" selected>4×</option><option value="8">8×</option></select></label>
    </div>
  </div>
  <div class="recording-details" hidden>
    <details class="saved-work" data-saved-work>
      <summary>Plan & decisions <span data-task-count>No plan yet</span></summary>
      <p data-no-plan>Codex hasn’t saved a plan yet.</p>
      <ol data-task-list></ol>
      <button type="button" class="saved-decision" data-decision hidden>Read the saved decision <span aria-hidden="true">↗</span></button>
      <p class="saved-checks" data-check-count>No checks recorded yet.</p>
    </details>
    <details class="recording-inspector" data-inspector>
      <summary>Files & output</summary>
      <div class="inspector-controls">
        <label>Message or action<select data-action-select aria-label="Message or action">{entries.map((entry,index)=><option value={index}>{timeLabel(entries,index)} · {entry.kind==="message"?entryTitle(entry):entry.event.title}</option>)}</select></label>
        <label>Show<select data-file aria-label="Recorded source or output"><option value="">Selected action or message</option></select></label>
      </div>
      <p class="source-note" data-source-note></p>
      <pre tabindex="0" aria-label="Recorded source and output"><code data-output></code></pre>
      <p class="recording-receipt" data-receipt></p>
    </details>
  </div>
  <p data-error role="status" class="recording-error" hidden></p>
  <details class="complete-transcript">
    <summary>Read the complete transcript</summary>
    <ol>{entries.map((entry,index)=><li><details><summary><time>{timeLabel(entries,index)}</time><span>{entry.kind==="message"?entryTitle(entry):entry.event.title}</span>{entry.kind==="action"&&<small>{eventStatus(entry.event)}</small>}</summary><pre>{entryBody(entry)}</pre></details></li>)}</ol>
  </details>
  <p class="sr-only" role="status" aria-live="polite" data-announcement></p>
  <div class="recording-footer">
    <p>Adapted from a Codex session · October 20, 2026.</p>
    <div class="recording-downloads"><a href={asset("source.zip")} download>Download the project</a><a href={asset("recording.json")} download>Session data</a></div>
  </div>
</div>
<script>
 import "../scripts/project-recording";
</script>
<style is:global>
.build-recording{margin-top:1.8rem;min-width:0}
.build-recording [hidden]{display:none!important}
.build-recording button{font:inherit;cursor:pointer;color:var(--color-text);background:transparent;border:1px solid transparent;border-radius:3px;min-height:44px;padding:.5rem .75rem;font-size:.8rem}
.build-recording button:hover{background:var(--color-surface)}
.build-recording button:disabled{cursor:default}
.build-recording :is(button,select,summary,input,.session-scroll,pre):focus-visible{outline:2px solid var(--color-accent);outline-offset:3px}
.session-terminal{--terminal-bg:#f8f8f5;--terminal-text:#232922;--terminal-muted:#5d655b;--terminal-rule:#d4d8d0;background:var(--terminal-bg);color:var(--terminal-text);border:1px solid var(--terminal-rule);font-family:var(--font-mono);font-size:.79rem;line-height:1.65}
.dark .session-terminal{--terminal-bg:#15191b;--terminal-text:#e2e6df;--terminal-muted:#a5aea3;--terminal-rule:#394139}
.terminal-heading{display:flex;align-items:center;gap:1rem;padding:.8rem 1.2rem;border-bottom:1px solid var(--terminal-rule)}
.terminal-heading strong{font-size:.96rem;font-weight:600;white-space:nowrap}.terminal-heading>span{color:var(--terminal-muted);font-size:.74rem}.terminal-heading small{margin-left:auto;color:var(--terminal-muted);font-size:.65rem}
.session-scroll{height:340px;overflow:auto;overscroll-behavior:contain;padding:1.2rem;scrollbar-width:thin;scroll-padding:1rem}
.session-entry{padding:0 0 1rem;scroll-margin:1rem}
.session-entry>button{width:100%;display:flex;align-items:baseline;gap:.55rem;text-align:left;color:var(--terminal-text);font:inherit;padding:0;min-height:28px;line-height:1.55}
.session-entry>button:hover{background:transparent;text-decoration:underline;text-underline-offset:3px}
.entry-bullet{color:var(--terminal-muted)}.entry-label{font-weight:500;overflow-wrap:anywhere}
.session-entry time{color:var(--terminal-muted);font-size:.65rem;margin-left:auto;white-space:nowrap}
.entry-status{font-size:.65rem;color:var(--terminal-muted);white-space:nowrap}
.entry-status[data-status="Failed"],.entry-status[data-status="Rejected"]{color:var(--color-error)}
.entry-status[data-status="Passed"],.entry-status[data-status="Completed"]{color:var(--color-green)}
.entry-summary{margin:0 0 0 1.05rem;color:var(--terminal-muted);font-size:.74rem;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;overflow:hidden}
.entry-detail{padding-left:1.05rem}.entry-purpose{margin:.25rem 0 .7rem;color:var(--terminal-muted);font-size:.74rem}
.entry-message{margin:.4rem 0 0;line-height:1.75;white-space:pre-wrap;overflow-wrap:anywhere;max-width:85ch}
.session-terminal pre{font:inherit;font-size:.74rem;line-height:1.65;white-space:pre-wrap;overflow-wrap:anywhere;margin:.5rem 0;color:inherit;background:transparent}
.session-terminal .entry-command{padding:.35rem 0 .65rem;border-bottom:1px solid var(--terminal-rule)}
.session-terminal .entry-expand{color:var(--terminal-muted);padding:.4rem 0;font:.71rem var(--font-mono);text-decoration:underline;text-underline-offset:3px}
.replay-controls{padding:.5rem 0 1rem}
.replay-scrubber{display:flex;align-items:center;gap:1rem}
.replay-scrubber input{flex:1;min-width:0;height:32px;margin:0;accent-color:var(--color-accent);cursor:ew-resize}
.replay-scrubber output{font:.7rem var(--font-mono);color:var(--color-text-muted);white-space:nowrap}
.replay-transport{display:flex;align-items:center;gap:.35rem;flex-wrap:wrap}
.replay-transport [data-play]{background:var(--color-accent);color:var(--color-on-accent);font-weight:600;min-width:72px}
.replay-transport :is([data-previous],[data-next]){width:44px;padding:.5rem;border-color:var(--color-border)}
.replay-transport button:disabled{opacity:.4}
.replay-jump{margin-left:auto}
.build-recording select{color:var(--color-text);background:var(--color-bg-card);border:1px solid var(--color-border);border-radius:3px;height:44px;font:inherit;max-width:100%;min-width:0;padding:.4rem .6rem}
.replay-jump select,.replay-speed select{font-size:.75rem}
.replay-speed select{width:60px}.replay-jump select{max-width:190px}
.recording-details{border-top:1px solid var(--color-border);margin-top:.25rem}
.build-recording summary{cursor:pointer;min-height:44px;font-size:.8rem;line-height:1.5;padding:.85rem 0;color:var(--color-text)}
.build-recording summary::marker{color:var(--color-text-muted);font-size:.7rem}
.recording-details>details+details,.complete-transcript{border-top:1px solid var(--color-border)}
.saved-work summary span{float:right;font:.69rem var(--font-mono);color:var(--color-text-muted);padding-top:.2rem}
.saved-work>p{font-size:.78rem;color:var(--color-text-muted);line-height:1.6}
.saved-work ol{list-style:none;padding:0;margin:.25rem 0;max-width:560px}
.saved-work li{display:grid;grid-template-columns:16px minmax(0,1fr) auto;gap:.45rem;padding:.4rem 0;font-size:.8rem}
.saved-work li small{color:var(--color-text-muted);font-size:.7rem}
.saved-work li[data-status="In progress"]{font-weight:600}.saved-work li[data-status="Completed"]>span:first-child{color:var(--color-green)}
.build-recording .saved-decision{padding:.4rem 0;text-decoration:underline;text-underline-offset:3px}
.inspector-controls{display:grid;grid-template-columns:3fr 2fr;gap:1rem;margin:.5rem 0 1rem}
.inspector-controls label{display:flex;flex-direction:column;gap:.4rem;font-size:.72rem;color:var(--color-text-muted);min-width:0}
.inspector-controls select{font-size:.8rem;width:100%}
.source-note{font-size:.73rem;color:var(--color-text-muted)}
.recording-inspector pre,.complete-transcript pre{background:var(--color-code);color:var(--color-code-text);font:.74rem/1.7 var(--font-mono);white-space:pre-wrap;overflow-wrap:anywhere;padding:1rem;max-height:430px;overflow:auto;scrollbar-width:thin}
.recording-receipt{font:.65rem/1.6 var(--font-mono);color:var(--color-text-muted);overflow-wrap:anywhere}
.complete-transcript>ol{max-height:600px;overflow:auto;list-style:none;margin:0;padding:0}
.complete-transcript li{border-top:1px solid var(--color-border)}
.complete-transcript li summary{display:flex;gap:.7rem;align-items:baseline}
.complete-transcript li summary::before{content:"›"}.complete-transcript li details[open]>summary::before{content:"⌄"}
.complete-transcript time,.complete-transcript small{font:.65rem var(--font-mono);color:var(--color-text-muted);white-space:nowrap}
.complete-transcript small{margin-left:auto}
.recording-footer{display:flex;align-items:baseline;justify-content:space-between;gap:.75rem 1rem;flex-wrap:wrap;border-top:1px solid var(--color-border);padding-top:1rem;margin-top:.25rem;font-size:.73rem;color:var(--color-text-muted)}
.recording-footer p{margin:0}.recording-downloads{display:flex;gap:1rem;flex-wrap:wrap}.recording-downloads a{color:var(--color-text);text-decoration:underline;text-underline-offset:3px}
.recording-error{color:var(--color-error);font-size:.85rem;line-height:1.6}
@media(max-width:600px){.session-scroll{height:400px;padding:.9rem}.terminal-heading{padding:.75rem .9rem;gap:.7rem}.terminal-heading small{font-size:.6rem}.entry-label{font-size:.75rem}.inspector-controls{grid-template-columns:1fr}.replay-jump select{max-width:155px}.recording-footer{padding-top:.85rem}}
@media(max-width:420px){.replay-jump{margin-left:0}.replay-jump select{max-width:145px}.replay-transport{display:grid;grid-template-columns:72px 44px 44px 1fr 60px}.replay-jump{grid-column:1/5}.replay-jump select{width:100%;max-width:none}.replay-speed{grid-column:5}.saved-work summary span{font-size:.64rem}}
</style>
