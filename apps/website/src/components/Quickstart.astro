---
const tabs = [
  { id: "clone", label: "1. Clone", command: "git clone https://github.com/AlrikOlson/magistr magistr" },
  { id: "build", label: "2. Install", command: "cargo install --locked --path magistr/crates/magistr-cli" },
  { id: "check", label: "3. Check", command: "magistr --version" },
];
---

<section id="quickstart" class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="mb-12 text-center sm:mb-16">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Build Magistr <span class="text-accent">from source</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-text-muted">
        Build with Rust 1.95 or later. v0.1 is an early release while the public package pipeline is being established. See the <a href="/docs/installation" class="text-accent underline">installation guide</a> and <a href="https://github.com/AlrikOlson/magistr/blob/main/docs/release-inventory.md" class="text-accent underline">release inventory</a>.
      </p>
    </div>

    <!-- Tabbed install -->
    <div class="quickstart-tabs rounded-xl border border-border" style="background-color: var(--color-bg-card);">
      <!-- Tab headers -->
      <div class="flex border-b border-border-hover" role="tablist" aria-label="Source installation steps">
        {tabs.map((tab, i) => (
          <button
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`panel-${tab.id}`}
            id={`tab-${tab.id}`}
            class:list={[
              "quickstart-tab px-5 py-3 text-sm font-medium transition-colors",
              i === 0 ? "text-accent border-b-2 border-accent" : "text-text-muted hover:text-text",
            ]}
            data-tab={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </div>

      <!-- Tab panels -->
      {tabs.map((tab, i) => (
        <div
          role="tabpanel"
          id={`panel-${tab.id}`}
          aria-labelledby={`tab-${tab.id}`}
          class:list={["quickstart-panel p-5", i !== 0 && "hidden"]}
          data-panel={tab.id}
        >
          <div class="flex items-center justify-between gap-4 rounded-lg border border-border px-4 py-3 font-mono text-sm" style="background-color: var(--color-bg);">
            <div class="flex items-center gap-3 overflow-x-auto">
              <span class="text-text-muted select-none">$</span>
              <code class="quickstart-command text-text whitespace-nowrap">{tab.command}</code>
            </div>
            <button
              class="quickstart-copy shrink-0 rounded-md border border-border-hover p-1.5 text-text-muted transition-colors hover:border-accent hover:text-accent"
              data-command={tab.command}
              aria-label={`Copy ${tab.label} install command`}
            >
              <svg class="h-4 w-4 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" />
                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
              </svg>
              <svg class="h-4 w-4 check-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12" />
              </svg>
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initQuickstart() {
    const tablist = document.querySelector(".quickstart-tabs");
    if (!tablist) return;

    // Tab switching
    const tabs = tablist.querySelectorAll<HTMLButtonElement>(".quickstart-tab");
    const panels = tablist.querySelectorAll<HTMLDivElement>(".quickstart-panel");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const targetId = tab.dataset.tab;

        tabs.forEach((t) => {
          const isActive = t.dataset.tab === targetId;
          t.setAttribute("aria-selected", String(isActive));
          t.classList.toggle("text-accent", isActive);
          t.classList.toggle("border-b-2", isActive);
          t.classList.toggle("border-accent", isActive);
          t.classList.toggle("text-text-muted", !isActive);
        });

        panels.forEach((p) => {
          p.classList.toggle("hidden", p.dataset.panel !== targetId);
        });
      });
    });

    // Copy buttons
    const copyBtns = tablist.querySelectorAll<HTMLButtonElement>(".quickstart-copy");
    copyBtns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const command = btn.dataset.command;
        if (!command) return;

        try {
          await navigator.clipboard.writeText(command);
          const copyIcon = btn.querySelector(".copy-icon");
          const checkIcon = btn.querySelector(".check-icon");
          copyIcon?.classList.add("hidden");
          checkIcon?.classList.remove("hidden");
          setTimeout(() => {
            copyIcon?.classList.remove("hidden");
            checkIcon?.classList.add("hidden");
          }, 2000);
        } catch {
          // Clipboard API not available
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initQuickstart);
  } else {
    initQuickstart();
  }
</script>
