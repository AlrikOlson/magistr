---
import ThemeToggle from "./ThemeToggle.astro";

/** The site's few destinations; the docs link goes straight to installation. */
const links = [
  { label: "How it works", href: "/#roadmap" },
  { label: "Your agent", href: "/#agents" },
  { label: "Get started", href: "/#install" },
  { label: "Docs", href: "/docs/installation" },
];
const current = Astro.url.pathname;
const isDocs = current.startsWith("/docs");
---
<nav class="site-nav" aria-label="Primary">
  <div class="nav-inner">
    <a href="/" class="brand" aria-label="Magistr home" aria-current={current === "/" ? "page" : undefined}>
      <img src="/favicon.svg" alt="" width="28" height="28" />
      <span>Magistr</span>
    </a>
    <div class="nav-links" data-nav-links>
      {links.map(({ label, href }) => (
        <a href={href} aria-current={href.startsWith("/docs") && isDocs ? "page" : undefined}>{label}</a>
      ))}
    </div>
    <div class="nav-actions">
      <ThemeToggle />
      <a class="github-link" href="https://github.com/AlrikOlson/magistr" target="_blank" rel="noopener noreferrer" aria-label="Magistr on GitHub (opens in a new tab)">
        <svg class="github-mark" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.084-.729.084-.729 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.3-1.23 3.3-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.895-.015 3.285 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12Z"/></svg>
        <span>GitHub</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="sr-only" data-menu-label>Open menu</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path class="menu-bars" d="M4 7h16M4 12h16M4 17h16" />
          <path class="menu-close" d="m6 6 12 12M6 18 18 6" />
        </svg>
      </button>
    </div>
  </div>
  <ul id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
    {links.map(({ label, href }) => <li><a href={href} aria-current={href.startsWith("/docs") && isDocs ? "page" : undefined}>{label}</a></li>)}
    <li><a href="https://github.com/AlrikOlson/magistr" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a></li>
  </ul>
</nav>
<script is:inline>
  (() => {
    const nav = document.querySelector(".site-nav");
    const toggle = nav?.querySelector("[data-menu-toggle]");
    const menu = nav?.querySelector("[data-mobile-menu]");
    if (!toggle || !menu) return;
    const setOpen = (open) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.querySelector("[data-menu-label]").textContent = open ? "Close menu" : "Open menu";
      menu.hidden = !open;
    };
    toggle.addEventListener("click", () => setOpen(menu.hidden));
    nav.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    nav.addEventListener("focusout", (event) => {
      if (!nav.contains(event.relatedTarget)) setOpen(false);
    });
    document.addEventListener("click", (event) => {
      if (!nav.contains(event.target)) setOpen(false);
    });
    menu.addEventListener("click", (event) => {
      const link = event.target.closest("a");
      if (!link) return;
      const url = new URL(link.href);
      setOpen(false);
      if (url.origin === location.origin && url.pathname === location.pathname && url.hash) {
        document.getElementById(url.hash.slice(1))?.focus({ preventScroll: true });
      }
    });
    matchMedia("(min-width: 801px)").addEventListener("change", (event) => {
      if (!event.matches) return;
      const focusedLink = menu.contains(document.activeElement) ? document.activeElement.getAttribute("href") : null;
      setOpen(false);
      if (focusedLink) {
        const destination = [...nav.querySelectorAll("[data-nav-links] a")].find((link) => link.getAttribute("href") === focusedLink);
        (destination ?? nav.querySelector(".brand")).focus();
      } else if (document.activeElement === toggle) {
        nav.querySelector(".brand").focus();
      }
    });
  })();
</script>
