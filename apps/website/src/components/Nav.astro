---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { label: "Why Magistr", href: "/#features" },
  { label: "How it works", href: "/#concept-maps" },
  { label: "Quickstart", href: "/#quickstart" },
  { label: "Docs", href: "/docs/installation" },
  { label: "Community", href: "/#community" },
];
---
<nav class="site-nav backdrop-blur" aria-label="Primary">
  <div class="nav-inner">
    <a href="/" class="brand" aria-label="Magistr home">
      <img src="/favicon.svg" alt="" width="28" height="28" />
      <span>Magistr</span>
    </a>
    <div class="nav-links" data-nav-links>
      {links.map(({ label, href }) => <a href={href}>{label}</a>)}
    </div>
    <div class="nav-actions">
      <ThemeToggle />
      <a class="github-link" href="https://github.com/AlrikOlson/magistr" target="_blank" rel="noopener noreferrer" aria-label="Magistr on GitHub">
        <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-.1-1.78-.89-3.64-3.95-3.64-.87 0-1.59.31-2.15.82-.2-.08-1.02-.36-2.12.08 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8Z"/></svg>
        <span>GitHub</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="sr-only">Open menu</span><span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
    {links.map(({ label, href }) => <a href={href}>{label}</a>)}
    <a href="https://github.com/AlrikOlson/magistr" target="_blank" rel="noopener noreferrer">GitHub</a>
  </div>
</nav>
<script is:inline>
  const toggle = document.querySelector("[data-menu-toggle]");
  const menu = document.querySelector("[data-mobile-menu]");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    if (menu) menu.hidden = open;
  });
</script>

