---
const maps = [
  {
    id: "decision-loop",
    title: "Decision loop",
    summary: "Talk through the direction with your agent, review its draft, then move one accepted ready item through context, work, and verification.",
    image: "/diagrams/magistr-roadmap-workflow.png",
    alt: "Flat 2D diagram of the Magistr decision loop: roadmap, conversation, agent draft, human review, work, and verification.",
  },
  {
    id: "ownership-boundary",
    title: "Ownership boundary",
    summary: "You set intent in conversation and review the draft inside your project; Magistr orders the accepted work and records the result locally.",
    image: "/diagrams/magistr-system-map.png",
    alt: "Flat 2D diagram of the ownership boundary between your project, agent runtime, Magistr workflow, and recorded evidence.",
  },
  {
    id: "evidence-chain",
    title: "Evidence chain",
    summary: "A roadmap change discussed with your agent stays attached to your review, the ready task you accept, its checks, and the recorded reason.",
    image: "/diagrams/magistr-evidence-chain.png",
    alt: "Flat 2D diagram of the Magistr evidence chain: roadmap, agent draft from your prompt, human review, ready task, checks, and record.",
  },
];
---

<section id="concept-maps" class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mb-12 text-center sm:mb-16">
      <p class="font-mono text-xs uppercase tracking-[0.24em] text-text-muted">A shared model</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        See how a <span class="text-accent">conversation changes the roadmap</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-text-muted">
        These Blender-rendered views show the same public model from three angles: how your direction becomes a roadmap change, where you keep control, and how proof returns to the plan.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
      {maps.map((map) => (
        <article class="flex flex-col overflow-hidden rounded-2xl border border-border" style="background-color: var(--color-bg-card);">
          <figure>
            <img src={map.image} alt={map.alt} class="h-auto w-full" loading="lazy" />
          </figure>
          <div class="flex flex-1 flex-col p-6">
            <h3 class="text-xl font-semibold text-text">{map.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">{map.summary}</p>
            <p class="mt-5 border-t border-border pt-4 text-xs font-mono uppercase tracking-[0.16em] text-text-muted">
              Blender-rendered · literal labels
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
