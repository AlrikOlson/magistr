---
const maps = [
  {
    id: "conversation",
    title: "Steer by conversation",
    summary: "Describe the outcome you want, review the agent's proposed roadmap change, and decide what enters the ready queue.",
    image: "/diagrams/magistr-conversation.svg",
    alt: "Four aligned cards show you describing a priority, an agent drafting a roadmap change, your review, and a ready chunk.",
  },
  {
    id: "modes",
    title: "Choose your loop",
    summary: "Use Codex or Claude when you want an agent-led session. Open the TUI when you want Magistr to own the interactive loop.",
    image: "/diagrams/magistr-modes.svg",
    alt: "Two aligned panels compare the Codex or Claude harness with the native TUI and show that both share native state.",
  },
  {
    id: "iteration",
    title: "Ship one chunk",
    summary: "A ready item moves through research, planning, workspace changes, verified gates, and a recorded result.",
    image: "/diagrams/magistr-next.svg",
    alt: "Five aligned cards show select, prepare, work, verify, and record stages for one Magistr iteration.",
  },
  {
    id: "state",
    title: "Resume from state",
    summary: "Roadmap, reasoning, ship actions, checks, and project configuration stay connected for the next session.",
    image: "/diagrams/magistr-state.svg",
    alt: "Three aligned panels show a project checkout, Magistr workflow records, and agent and workspace clients connected through one local service.",
  },
];
---

<section id="concept-maps" class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mb-12 text-center sm:mb-16">
      <p class="font-mono text-xs uppercase tracking-[0.24em] text-text-muted">A shared model</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        See how <span class="text-accent">Magistr fits your workflow</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-text-muted">
        Four views answer the questions that matter when you start: how to steer the roadmap, which loop owns the work, what one iteration does, and what remains when you return.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      {maps.map((map) => (
        <article class="flex flex-col overflow-hidden rounded-2xl border border-border" style="background-color: var(--color-bg-card);">
          <figure>
            <img src={map.image} alt={map.alt} class="h-auto w-full" loading="lazy" />
          </figure>
          <div class="flex flex-1 flex-col p-6">
            <h3 class="text-xl font-semibold text-text">{map.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">{map.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
