---
import TerminalFrame from "./TerminalFrame.astro";

const steps = [
  {
    number: 1,
    title: "Initialize your project",
    description: "Magistr detects your stack and generates agent configs — hooks, rules, skills, and project.json — tailored to your codebase.",
    command: "magistr init",
    output: `Detected: Rust (edition 2024)
  ✓ Generated .claude/rules/conventions.md
  ✓ Generated .claude/rules/workflow.md
  ✓ Created .magistr/project.json
  ✓ Created .magistr-roadmap.yml`,
  },
  {
    number: 2,
    title: "Start your first iteration",
    description: "Magistr reads your roadmap, picks the next chunk, and runs a full research-plan-execute-verify cycle autonomously.",
    command: "magistr next",
    output: `Phase: research → plan → execute → verify
  ✓ Read ROADMAP.md — found 12 unchecked items
  ✓ Planned 4 tasks for this iteration
  ✓ Implemented with TDD (3 tests green)
  ✓ Quality gates passed (check + test + lint)
  ✓ Committed: feat: add user authentication`,
  },
  {
    number: 3,
    title: "Watch it work in the TUI",
    description: "A polished terminal dashboard shows real-time streaming output, task progress, file changes, and session stats.",
    command: "magistr next-loop",
    output: `┌─ Magistr ─────────────────────────────┐
│ Phase: execute  ▓▓▓▓▓▓▓░░░  70%  │
│ Tasks: 3/4 complete               │
│ Stream: writing auth middleware... │
│ Files: +3 ~2                      │
└───────────────────────────────────┘`,
  },
];
---

<section class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="mb-12 text-center sm:mb-16">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        From zero to <span class="text-accent">shipping</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-text-muted">
        Three commands. That's all it takes.
      </p>
    </div>

    <div class="space-y-8">
      {steps.map((step) => (
        <div class="walkthrough-step group">
          <!-- Step header -->
          <div class="mb-3 flex items-center gap-3">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-accent/30 bg-accent/10 font-mono text-sm font-bold text-accent">
              {step.number}
            </span>
            <h3 class="text-lg font-semibold text-text">{step.title}</h3>
          </div>

          <p class="mb-4 pl-11 text-sm leading-relaxed text-text-muted">
            {step.description}
          </p>

          <!-- Terminal block -->
          <TerminalFrame class="ml-11">
            <div class="p-4 font-mono text-sm">
              <div class="flex items-center gap-2">
                <span class="text-text-muted select-none">$</span>
                <span class="text-accent">{step.command}</span>
              </div>
              <pre class="mt-2 whitespace-pre text-text-muted leading-relaxed">{step.output}</pre>
            </div>
          </TerminalFrame>
        </div>
      ))}
    </div>
  </div>
</section>
