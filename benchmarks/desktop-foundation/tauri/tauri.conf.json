{
  "productName": "Magistr",
  "version": "0.1.0",
  "identifier": "dev.magistr.foundation.tauri",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Magistr",
        "width": 1280,
        "height": 832,
        "minWidth": 720,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../assets/icon.png"]
  }
}
