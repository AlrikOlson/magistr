{
  "productName": "Magistr",
  "version": "0.1.0",
  "identifier": "dev.magistr.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Magistr",
        "width": 1280,
        "height": 832,
        "minWidth": 760,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "ui/icon.png"
    ]
  }
}
