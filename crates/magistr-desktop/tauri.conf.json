{
  "productName": "Magistr",
  "identifier": "dev.magistr.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Magistr",
        "width": 1280,
        "height": 832,
        "minWidth": 760,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Work with coding agents across your projects",
    "icon": [
      "ui/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
