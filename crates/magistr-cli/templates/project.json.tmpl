{
  "project": {
    "name": "{{project_name}}",
    "description": "{{project_description}}",
    "type": "{{project_type}}"
  },
  "stack": {
    "language": "{{language}}",
    "framework": "{{framework}}",
    "package_manager": "{{package_manager}}",
    "test_framework": "{{test_framework}}",
    "linter": "{{linter}}",
    "formatter": "{{formatter}}"
  },
  "quality_gate": {
    "check": "{{check_cmd}}",
    "test": "{{test_cmd}}",
    "lint": "{{lint_cmd}}"
  },
  "format": {
    "extensions": [{{format_extensions}}],
    "command": "{{format_cmd}}"
  },
  "roadmap_backend": "think-and-ship",
  "spec": {
    "file": ".magistr-roadmap.yml",
    "unchecked_pattern": "^\\s*- \\[ \\]"
  },
  "testing": {
    "companion_pattern": "{{companion_pattern}}",
    "test_dir": "{{test_dir}}"
  },
  "reference_repos": [{{reference_repos}}],
  "state_prefix": "{{state_prefix}}"
}
