# Seeded by `magistr init` from .magistr/project.json (and `magistr init` manifest detection).
# Amend by hand: this table is workspace `run`'s allowlist and only a human may change it.
[commands]
"check" = "cargo check --all-targets" # project.json quality_gate.check
"test" = "cargo nextest run" # project.json quality_gate.test
"lint" = "cargo clippy -- -D warnings" # project.json quality_gate.lint
"format" = "cargo fmt" # project.json format.command
