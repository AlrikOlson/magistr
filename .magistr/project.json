				],
				"reuse": true,
				"timeout_secs": 120,
				"resources": []
			},
			"release-latency": {
				"inputs": [
					"crates/magistr-desktop",
					"docs/evidence/desktop-current",
					"scripts"
				],
				"reuse": true,
				"timeout_secs": 60,
				"resources": []
			},
			"machete": {
				"reuse": false,
				"timeout_secs": 120,
				"resources": [
					"cargo"
				]
			},
			"legacy-gui": {
				"reuse": false,
				"timeout_secs": 60,
				"resources": []
			},
			"workspace-native": {
				"reuse": false,
				"timeout_secs": 1200,
				"resources": [
					"cargo"
				]
			},
			"workspace-reference": {
				"reuse": false,
				"timeout_secs": 1800,
				"resources": [
					"cargo",
					"workspace-reference"
				]
			},
			"workspace-release-smoke": {
				"reuse": false,
				"timeout_secs": 1200,
				"resources": [
					"cargo"
				]
			}
		}
